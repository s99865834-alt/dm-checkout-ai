{% comment %}
  Re-apply the last clicked link onto the cart on every page.
  The /a/go/ bounce stamps the cart once. A later permalink, an emptied
  cart, or a return visit in the same browser drops that attribute unless
  something puts it back before checkout. No cookie means no request.
{% endcomment %}
<script>
(function () {
  try {
    var match = document.cookie.match(/(?:^|; )sr_ref=([^;]*)/);
    if (!match) return;
    var ref = decodeURIComponent(match[1]);
    if (ref.indexOf("link_") !== 0) return;
    fetch("/cart.js", { credentials: "same-origin" })
      .then(function (response) { return response.json(); })
      .then(function (cart) {
        if (cart && cart.attributes && cart.attributes.ref === ref) return null;
        return fetch("/cart/update.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          keepalive: true,
          body: JSON.stringify({ attributes: { ref: ref } })
        });
      })
      .catch(function () {});
  } catch (e) {}
})();
</script>
{% schema %}
{
  "name": "SocialRepl attribution",
  "target": "head",
  "settings": []
}
{% endschema %}
